{
	"name": "pronamic/wp-orbis-infinitewp",
	"description": "The Orbis InfiniteWP plugin can check InfiniteWP sites against Orbis subscriptions.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"wp-slug": "orbis-infinitewp"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"deployer/deployer": "^7.5"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis-infinitewp",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-infinitewp/",
			"vendor/bin/wp i18n make-pot ./build/orbis-infinitewp/ --slug=orbis-infinitewp",
			"vendor/bin/wp i18n make-mo ./build/orbis-infinitewp/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-infinitewp/ --plugin-dirname=orbis-infinitewp --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-infinitewp",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-infinitewp/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-infinitewp.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"qa": [
			"@phpcs"
		]
	}
}
